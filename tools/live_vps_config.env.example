# Live VPS E2E Test Runner Configuration Template
# Copy this file to tools/live_vps_config.env and set chmod 0600.
# All parameters are validated by tools/live_vps/config.py against a strict whitelist.

# ==============================================================================
# Master VPS Target Configuration
# ==============================================================================
# Public IPv4 address of Master VPS (disallowed: RFC-1918 private, loopback, docs ranges)
MASTER_IP=203.0.113.10

# Master Panel Domain (must resolve to MASTER_IP)
MASTER_PANEL_DOMAIN=panel.example.com

# Master REALITY camouflage decoy domain (must resolve to MASTER_IP)
MASTER_REALITY_DOMAIN=decoy-master.example.com

# Optional dedicated domain for Master VLESS+XTLS Vision. Independent of Worker Vision.
# MASTER_VISION_DOMAIN=vision-master.example.com

# Master SSH port and user
MASTER_SSH_PORT=22
MASTER_SSH_USER=root

# ==============================================================================
# Worker VPS Target Configuration
# ==============================================================================
# Public IPv4 address of Worker VPS
WORKER_IP=203.0.113.20

# Worker NGINX HTTPS domain (must resolve to WORKER_IP)
WORKER_DOMAIN=worker1.example.com

# Worker REALITY camouflage decoy domain (must resolve to WORKER_IP)
WORKER_REALITY_DOMAIN=decoy-worker.example.com

# Optional dedicated domain for Worker VLESS+XTLS Vision. Independent of Master Vision.
# WORKER_VISION_DOMAIN=vision-worker.example.com

# Worker SSH port and user
WORKER_SSH_PORT=22
WORKER_SSH_USER=root

# ==============================================================================
# SSH Authentication & Host Identity Pinning
# ==============================================================================
# Path to private SSH key used to authenticate to both VPS
SSH_KEY_PATH=/root/.ssh/id_ed25519

# Path to pre-pinned known_hosts containing host keys for both Master and Worker
SSH_KNOWN_HOSTS=/root/.ssh/known_hosts
# Optional per-host overrides (recommended when CI uses separate credentials).
# MASTER_SSH_KEY_PATH=/root/.ssh/id_master
# WORKER_SSH_KEY_PATH=/root/.ssh/id_worker
# MASTER_KNOWN_HOSTS_PATH=/root/.ssh/known_hosts_master
# WORKER_KNOWN_HOSTS_PATH=/root/.ssh/known_hosts_worker

# ==============================================================================
# ACME TLS Certification Mode
# ==============================================================================
# Mode: 'staging' (default, uses Let's Encrypt staging directory) or 'production'
ACME_MODE=staging

# Let's Encrypt registration email
ADMIN_EMAIL=admin@example.com

# ==============================================================================
# Software Version & Digest Pinning
# ==============================================================================
# Pinned GoWave Panel release version or commit
GOWAVE_PANEL_VERSION=v1.2.4

# Pinned GoWave Node release version or commit
GOWAVE_NODE_VERSION=v1.1.3

# Pinned upstream install.sh commit (40-hex SHA)
GOWAVE_NODE_INSTALLER_COMMIT=7b3514d1ab8c674050597820d52d55525d4bece7

# SHA256 of upstream install.sh at GOWAVE_NODE_INSTALLER_COMMIT
GOWAVE_NODE_INSTALLER_SHA256=9a524f1383d3a6a8be42ac370699b0ec6725678ece4abe5b5bc61e8c2af682d0

# Expected GoWave Node-managed Xray/rw-core version on both VPS.
# mihomoX25519 stays enabled for v26.9.9+ pins so mihomo keeps the hybrid
# X25519MLKEM768 key share in its REALITY ClientHello.
XRAY_SERVER_VERSION=26.11.9

# Pinned Xray client binary version on Control Machine
XRAY_CLIENT_VERSION=26.11.9

# Pinned Mihomo client binary version on Control Machine
MIHOMO_CLIENT_VERSION=1.19.34

# uTLS fingerprint provisioned on REALITY Host records
# (chrome|firefox|safari|ios|android|edge|360|qq|random|randomized).
# Defaults to firefox; Xray and mihomo both authenticate with it.
REALITY_FINGERPRINT=firefox

# ==============================================================================
# IPv6 Verification (Optional)
# ==============================================================================
ENABLE_IPV6=false
# MASTER_IPV6=2001:db8::1
# WORKER_IPV6=2001:db8::2

# ==============================================================================
# Egress IP Expectations (Optional)
# ==============================================================================
# EXPECTED_MASTER_EGRESS_IP=203.0.113.10
# EXPECTED_WORKER_EGRESS_IP=203.0.113.20

# ==============================================================================
# Timeouts & Polling Limits
# ==============================================================================
# Bounded timeout for Worker node registration isConnected: true (seconds)
NODE_READY_TIMEOUT=120

# Panel REST API request timeout (seconds)
API_TIMEOUT=15

# Data Plane tunnel request timeout (seconds)
TRAFFIC_TIMEOUT=30

# External snapshot restore timeout (seconds)
RESTORE_TIMEOUT=900

# ==============================================================================
# Test Execution Flags
# ==============================================================================
# Execute Data Plane VPN tunnel verification (false forces overall INCOMPLETE)
TEST_TRAFFIC_VERIFICATION=true

# Execute Mihomo client traffic cases (false forces overall INCOMPLETE)
TEST_MIHOMO_TRAFFIC=true

# Execute negative fault injection suite NEG-01..NEG-15 (false forces overall INCOMPLETE)
TEST_NEGATIVE_SUITE=true

# ==============================================================================
# Teardown & Lifecycle Policy
# ==============================================================================
# Policy: 'PRESERVE' (default) or 'RESTORE_SNAPSHOT' ('DESTROY' is rejected in v1)
TEST_TEARDOWN_POLICY=PRESERVE

# If TEST_TEARDOWN_POLICY=RESTORE_SNAPSHOT, the following four are mandatory:
# MASTER_SNAPSHOT_ID=snap-master-001
# WORKER_SNAPSHOT_ID=snap-worker-001
# SNAPSHOT_RESTORE_HOOK=/usr/local/bin/restore-vps-snapshots
# SNAPSHOT_RESTORE_HOOK_SHA256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
