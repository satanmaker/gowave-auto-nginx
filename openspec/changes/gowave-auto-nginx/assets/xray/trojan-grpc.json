{
  "tag": "trojan-grpc-{{NODE_NAME}}",
  "port": 10003,
  "listen": "127.0.0.1",
  "protocol": "trojan",
  "settings": {
    "clients": []
  },
  "streamSettings": {
    "network": "grpc",
    "security": "none",
    "grpcSettings": {
      "serviceName": "trojan-grpc",
      "multiMode": true
    }
  },
  "sniffing": {
    "enabled": true,
    "destOverride": [
      "http",
      "tls",
      "quic"
    ],
    "metadataOnly": false,
    "routeOnly": true
  }
}
