{
  "tag": "vless-xhttp-{{NODE_NAME}}",
  "port": 10001,
  "listen": "127.0.0.1",
  "protocol": "vless",
  "settings": {
    "clients": [],
    "decryption": "none"
  },
  "streamSettings": {
    "network": "xhttp",
    "security": "none",
    "xhttpSettings": {
      "path": "/xhttp-down/",
      "host": "",
      "mode": "packet-up"
    }
  },
  "sniffing": {
    "enabled": true,
    "destOverride": [
      "http",
      "tls",
      "quic"
    ],
    "metadataOnly": false,
    "routeOnly": true
  }
}
